#!/bin/bash
# LIBRE VTT, versione «tutto dentro» (quella del .dmg).
# Il programma sta dentro l'app (Contents/Resources/app) e lì non si scrive mai: le campagne
# vanno in Documenti, il resto nella cartella dell'utente. Per questo l'app funziona da
# qualsiasi posto: Applicazioni, la Scrivania, o direttamente dal disco del .dmg.

RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
APP="$RES/app"
SUPPORT="${MYVTT_USERDIR:-$HOME/Library/Application Support/LIBRE VTT}"
LOGDIR="${MYVTT_LOGDIR:-$HOME/Library/Logs/LIBRE VTT}"
# prima si chiamava «MY VTT»: la sua cartella passa alla nuova, una volta sola
VECCHIA="$HOME/Library/Application Support/MY VTT"
[ -z "${MYVTT_USERDIR:-}" ] && [ ! -e "$SUPPORT" ] && [ -d "$VECCHIA" ] && mv "$VECCHIA" "$SUPPORT" 2>/dev/null
mkdir -p "$SUPPORT" "$LOGDIR"
LOG="$LOGDIR/avvio.log"
: > "$LOG"
export MYVTT_USERDIR="$SUPPORT"
# opzioni di Node lasciate da altri programmi installati: qui non devono valere
unset NODE_OPTIONS NODE_PATH

# Se Node manca lo si scarica dal sito ufficiale (dopo averlo chiesto): ramo LTS 22.
DIST="${MYVTT_NODE_DIST:-https://nodejs.org/dist/latest-v22.x}"
case "$(uname -m)" in arm64) ARCH=arm64 ;; *) ARCH=x64 ;; esac

log() { echo "$*" >> "$LOG"; }
avviso() {   # una finestra di avviso: non c'è nessun Terminale a cui scrivere
  local msg; msg="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  osascript -e "display dialog \"$msg\" buttons {\"OK\"} default button 1 with title \"LIBRE VTT\" with icon caution" >/dev/null 2>&1
}
log "LIBRE VTT · $(date)"
log "programma: $APP"

# Se siamo qui, chi usa il Mac ha già dato il permesso di aprire l'app. Il bollino «scaricato
# da internet» però resta su ogni file dentro, e macOS potrebbe fermare uno per uno i programmi
# che l'app accende (Node, il collegamento a distanza). Lo si toglie una volta per tutte —
# dove si può scrivere, cioè non dal disco del .dmg ma dopo averla copiata in Applicazioni.
BUNDLE="$(cd "$RES/../.." && pwd)"
if command -v xattr >/dev/null && xattr -p com.apple.quarantine "$BUNDLE" >/dev/null 2>&1; then
  xattr -dr com.apple.quarantine "$BUNDLE" >/dev/null 2>&1 && log "tolto il bollino di quarantena dall'app"
fi

# Node va bene se c'è ed è almeno la 18.
node_ok() { [ -x "$1" ] && v="$("$1" -v 2>/dev/null)" && [ "${v#v}" != "$v" ] && [ "$(echo "${v#v}" | cut -d. -f1)" -ge 18 ] 2>/dev/null; }
trova_node() {
  local n p
  # 1. dentro l'app (la versione completa ce l'ha già)
  for n in "$RES/node/$ARCH/bin/node" "$RES/node/bin/node"; do node_ok "$n" && { echo "$n"; return; }; done
  # 2. scaricato da noi una volta precedente (il più recente; "Application Support" ha uno spazio)
  local cand=()
  for n in "$SUPPORT"/node/node-v*-darwin-"$ARCH"; do [ -d "$n" ] && cand+=("$n"); done
  if [ ${#cand[@]} -gt 0 ]; then
    while IFS= read -r n; do node_ok "$n/bin/node" && { echo "$n/bin/node"; return; }; done < <(printf '%s\n' "${cand[@]}" | sort -rV)
  fi
  # 3. già installato sul Mac (da Finder il PATH è corto: lo si cerca dove sta di solito)
  for p in /opt/homebrew/bin /usr/local/bin /usr/bin "$HOME/.volta/bin" "$HOME"/.nvm/versions/node/*/bin "$HOME/.local/bin"; do
    node_ok "$p/node" && { echo "$p/node"; return; }
  done
  n="$(command -v node 2>/dev/null)"; node_ok "$n" && echo "$n"
}

sha256() { if command -v shasum >/dev/null; then shasum -a 256 "$1"; else sha256sum "$1"; fi | awk '{print $1}'; }

scarica_node() {
  local risp
  risp="$(osascript -e 'button returned of (display dialog "Per funzionare, LIBRE VTT ha bisogno di Node.js: un programma gratuito di circa 45 MB.\n\nLo scarico io dal sito ufficiale (nodejs.org) e lo tengo solo per LIBRE VTT, senza toccare nient'\''altro sul Mac. Si fa una volta sola." buttons {"Annulla", "Scarica"} default button "Scarica" cancel button "Annulla" with title "LIBRE VTT" with icon note)' 2>/dev/null)"
  [ "$risp" = "Scarica" ] || return 1
  osascript -e 'display notification "Sto scaricando Node.js… ci vuole circa un minuto." with title "LIBRE VTT"' >/dev/null 2>&1
  local T; T="$(mktemp -d)"
  log "scarico l'elenco da $DIST"
  if ! curl -fsSL --retry 2 --connect-timeout 20 "$DIST/SHASUMS256.txt" -o "$T/SHASUMS256.txt" >>"$LOG" 2>&1; then
    avviso "Non riesco a raggiungere nodejs.org. Controlla la connessione a internet e riapri LIBRE VTT."; rm -rf "$T"; return 1
  fi
  local FILE; FILE="$(grep -oE "node-v[0-9]+\.[0-9]+\.[0-9]+-darwin-$ARCH\.tar\.gz" "$T/SHASUMS256.txt" | head -1)"
  if [ -z "$FILE" ]; then avviso "Sul sito di Node non trovo la versione per questo Mac ($ARCH)."; rm -rf "$T"; return 1; fi
  log "scarico $FILE"
  if ! curl -fSL --retry 2 --connect-timeout 20 "$DIST/$FILE" -o "$T/$FILE" >>"$LOG" 2>&1; then
    avviso "Lo scaricamento di Node.js si è interrotto. Riapri LIBRE VTT per riprovare."; rm -rf "$T"; return 1
  fi
  # si controlla che il file sia proprio quello pubblicato
  local ATTESO VERO
  ATTESO="$(grep "  $FILE\$" "$T/SHASUMS256.txt" | awk '{print $1}')"
  VERO="$(sha256 "$T/$FILE")"
  if [ -z "$ATTESO" ] || [ "$ATTESO" != "$VERO" ]; then
    log "impronta attesa $ATTESO, trovata $VERO"
    avviso "Il file di Node.js arrivato non è integro: per sicurezza non lo uso. Riapri LIBRE VTT per riprovare."; rm -rf "$T"; return 1
  fi
  local DIRN="${FILE%.tar.gz}"
  if ! tar -xzf "$T/$FILE" -C "$T" >>"$LOG" 2>&1; then avviso "Non riesco a estrarre Node.js."; rm -rf "$T"; return 1; fi
  mkdir -p "$SUPPORT/node"
  rm -rf "$SUPPORT/node/$DIRN"
  mv "$T/$DIRN" "$SUPPORT/node/$DIRN"
  rm -rf "$T"
  log "Node pronto in $SUPPORT/node/$DIRN"
  return 0
}

NODE="$(trova_node)"
if [ -z "$NODE" ]; then
  scarica_node || exit 0
  NODE="$(trova_node)"
fi
if [ -z "$NODE" ]; then avviso "Non riesco a far partire Node.js. Il registro è in: $LOG"; exit 1; fi
log "node: $NODE ($("$NODE" -v 2>&1))"

cd "$APP" || exit 1
"$NODE" "$APP/server/launcher.js" >> "$LOG" 2>&1 &
PID=$!
sleep 4
if ! kill -0 "$PID" 2>/dev/null; then
  wait "$PID"; CODE=$?
  [ "$CODE" -eq 0 ] && exit 0            # era già aperto: ha solo mostrato la finestra
  avviso "LIBRE VTT si è chiuso subito dopo l'avvio.

Ultime righe del registro ($LOG):

$(tail -n 20 "$LOG")"
  exit 1
fi
wait "$PID"; CODE=$?
if [ "$CODE" -ne 0 ]; then
  avviso "LIBRE VTT si è fermato con un errore (codice $CODE).

Ultime righe del registro ($LOG):

$(tail -n 20 "$LOG")"
fi
exit "$CODE"
